# RHOIM Environment Variables for bootc Model Serving (Container Mode, GPU-only)
# These variables are passed to the RHAIIS vLLM container via Quadlet

# --- Core Configuration ---
MODEL_ID="TinyLlama/TinyLlama-1.1B-Chat-v1.0"
VLLM_PORT="8000"
VLLM_HOST="0.0.0.0"

# --- GPU device configuration ---
# This image runs vLLM in a container with GPU passthrough via CDI.
# The container automatically receives all NVIDIA GPUs.
# Requirements:
# - NVIDIA drivers on the host (installed in this bootc image)
# - CDI configuration generated by nvidia-post-boot-setup.service
VLLM_DEVICE_TYPE="cuda"
RHOIM_ACCELERATOR_MODE="gpu"

# Optional: extra args passed directly to vLLM OpenAI API server
# Examples: --max-model-len 4096 --tensor-parallel-size 2
VLLM_EXTRA_ARGS=""

# --- Gateway/API Configuration (if applicable) ---
API_KEYS="devkey1,devkey2"
