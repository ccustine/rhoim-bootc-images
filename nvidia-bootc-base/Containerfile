# =============================================================================
# RHEL 9 Bootc Base Image with NVIDIA CUDA Userspace Libraries
# =============================================================================
# This image provides a GPU-enabled RHEL 9 bootc base for inference workloads.
#
# IMPORTANT: This image does NOT include kernel modules. The NVIDIA kernel
# modules must be loaded on the host system. This image only provides the
# CUDA userspace libraries needed by applications.
#
# Use this as a base layer for vLLM, RHAIIS, or custom inference applications.
#
# NOTE: Multi-stage squashing via FROM scratch breaks hardlinks required by
# ostree/bootc. This single-stage build preserves hardlink integrity.
# =============================================================================
FROM registry.redhat.io/rhaiis/vllm-cuda-rhel9:latest as rhaiis

# RHAIIS base image runs as non-root (USER 1001:0). We need root for RPM installs and system setup.
USER 0

# ---- Install what bootc+systemd appliance needs (keep minimal) ----
# NOTE: Depending on the RHAIIS image contents, some of these may already exist.
RUN dnf -y install \
      systemd \
      jq \
      procps-ng \
      which \
    && dnf clean all

# Install huggingface-cli, but keep huggingface_hub compatible with transformers in this stack
RUN python3 -m pip install --no-cache-dir --upgrade --force-reinstall \
    "huggingface_hub>=0.34.0,<1.0"


# ---- Runtime environment (keep your safety toggles) ----
# Override HF_HUB_OFFLINE=1 from base image to allow model downloads
ENV PYTHONUNBUFFERED=1 \
    TORCHDYNAMO_DISABLE=1 \
    TORCHINDUCTOR_DISABLE=1 \
    VLLM_USE_TORCH_COMPILE=0 \
    VLLM_USE_TRITON=0 \
    RHOIM_ACCELERATOR_MODE=gpu \
    HF_HUB_OFFLINE=0

# ---- RHOIM config + entrypoint ----
COPY etc/ /etc/
COPY vllm/initializer-entrypoint.sh /usr/local/bin/initializer-entrypoint.sh
RUN chmod +x /usr/local/bin/initializer-entrypoint.sh

# ---- Users + layout ----
# NOTE: `systemctl enable` can fail during container build (no running systemd).
# For bootc/systemd images, enabling via symlink is equivalent.
RUN systemd-sysusers && \
    mkdir -p /opt/rhoim/{bin,models,gateway} /tmp/models /sysroot && \
    chown -R rhoim:rhoim /opt/rhoim /tmp/models && \
    mkdir -p /etc/systemd/system/multi-user.target.wants && \
    ln -sf /usr/lib/systemd/system/rhoim-vllm.service /etc/systemd/system/multi-user.target.wants/rhoim-vllm.service

# ---- Verify vLLM exists in the base image (fail at build time if not) ----
RUN python3 -c "import vllm; import torch; print('vllm OK:', vllm.__version__, '| torch:', torch.__version__)" && \
    command -v nvidia-smi >/dev/null 2>&1 || true

EXPOSE 8000

# ---- bootc metadata ----
LABEL org.osbuild.bootc=true bootc=true
# If bootc is not present in the base image, do not fail the build.
RUN command -v bootc >/dev/null 2>&1 && bootc container lint || true

# Restore the base image default user (non-root, root group)
USER 1001:0

# Clear the base image ENTRYPOINT (which runs vLLM directly) so we can use systemd
ENTRYPOINT []
CMD ["/sbin/init"]

FROM registry.redhat.io/rhel9/rhel-bootc:latest
#as bootc_base

# Mark as bootc-compatible - ostree.bootable is required for bootc to recognize the image
LABEL containers.bootc=1 \
      ostree.bootable=true \
      org.osbuild.bootc=true \
      description="RHEL 9 Bootc base image with NVIDIA CUDA userspace libraries (no kernel modules)"

# Install NVIDIA CUDA userspace libraries (x86_64 only) and container toolkit
# NOTE: Kernel modules are NOT installed - they must be present on the host
RUN if [ "$(uname -m)" = "x86_64" ]; then \
      echo "Installing NVIDIA CUDA userspace libraries for x86_64..." && \
      # Install required dependencies for NVIDIA libraries (X11, OpenGL, Vulkan, etc.)
      dnf install -y \
        libX11 \
        libXext \
        libglvnd \
        libglvnd-egl \
        libglvnd-gles \
        libglvnd-glx \
        libglvnd-opengl \
        libvdpau \
        vulkan-loader \
        ocl-icd \
        opencl-filesystem && \
      # Add NVIDIA CUDA repository for RHEL 9
      dnf config-manager --add-repo \
        https://developer.download.nvidia.com/compute/cuda/repos/rhel9/x86_64/cuda-rhel9.repo && \
      # Install CUDA userspace libraries only (no kernel modules)
      # nvidia-driver-libs: Core userspace libraries (libcuda, libnvidia-ml, etc.)
      # nvidia-driver-cuda-libs: CUDA runtime libraries
      # nvidia-driver-NVML: NVIDIA Management Library
      dnf install -y \
        nvidia-driver-libs \
        nvidia-driver-cuda-libs \
        nvidia-driver-NVML && \
      # Install NVIDIA Container Toolkit (for nested container GPU access)
      curl -s -L https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo | \
        tee /etc/yum.repos.d/nvidia-container-toolkit.repo && \
      dnf install -y nvidia-container-toolkit && \
      # Verify CUDA libraries are installed
      echo "Checking NVIDIA CUDA libraries..." && \
      ldconfig -p | grep -E "(libcuda|libnvidia)" | head -10 && \
      # Clean up all caches to minimize layer size
      dnf clean all && \
      rm -rf /var/cache/dnf /var/cache/yum /var/log/dnf* /var/log/yum*; \
    else \
      echo "Skipping NVIDIA libraries on $(uname -m) (CPU-only mode)"; \
    fi

COPY --from=rhaiis /etc /etc
COPY --from=rhaiis /opt /opt
COPY --from=rhaiis /root /root
COPY --from=rhaiis /run /run
COPY --from=rhaiis /usr /usr
COPY --from=rhaiis /var /var